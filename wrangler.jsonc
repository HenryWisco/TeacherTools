{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supply-closet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supply-closet",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret settings. Secrets (ANTHROPIC_API_KEY, ADMIN_TOKEN, IP_SALT, SUPPORTER_CODE)
  // are set with `npx wrangler secret put NAME` and never committed.
  "vars": {
    "SITE_NAME": "Supply Closet",
    "SITE_TAGLINE": "Free classroom materials, made in seconds.",
    "SITE_URL": "",
    "CONTACT_EMAIL": "",
    "MODEL": "claude-haiku-5-5",
    "DAILY_LIMIT_PER_IP": "40",
    "GLOBAL_DAILY_LIMIT": "5000",
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT": "",
    "AMAZON_TAG": "",
    "SUPPORT_URL": "",
    "SPONSOR_TEXT": "",
    "SPONSOR_URL": "",
    "SHOW_AD_PLACEHOLDERS": ""
  }
}
