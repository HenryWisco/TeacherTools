{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supply-closet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supply-closet",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret settings. Secrets (ANTHROPIC_API_KEY, ADMIN_TOKEN, IP_SALT, SUPPORTER_CODE)
  // are set with `npx wrangler secret put NAME` and never committed.
  "vars": {
    "SITE_NAME": "Supply Closet",
    "SITE_TAGLINE": "Free classroom materials, made in seconds.",
    "SITE_URL": "",
    // Who runs the site and how to reach them. Both are shown publicly: in the footer and on
    // the About, Privacy, Terms and For schools pages. Fill in both before launch.
    "OWNER_NAME": "",
    "CONTACT_EMAIL": "",
    "MODEL": "claude-haiku-5-5",
    // Work every answer key a second time and fix what is wrong before the teacher prints it.
    // Adds roughly half again to the cost of a document (more when a rewrite is needed). "0" turns it off.
    "CHECK_ANSWERS": "1",
    // Documents per day: one browser, one network (a whole school shares one), whole site.
    "DAILY_LIMIT_PER_DEVICE": "40",
    "DAILY_LIMIT_PER_NETWORK": "600",
    "GLOBAL_DAILY_LIMIT": "5000",
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT": "",
    // Leave blank for non-personalized ads (safer with schools). Set to "1" to allow personalized ads.
    "ADS_PERSONALIZED": "",
    "AMAZON_TAG": "",
    "SUPPORT_URL": "",
    "SPONSOR_TEXT": "",
    "SPONSOR_URL": "",
    "SHOW_AD_PLACEHOLDERS": ""
  }
}
